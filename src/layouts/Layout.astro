---
import '../styles/global.css';
const { title = 'Safwan Ahmed — Developer & Curious Builder', description = 'Safwan Ahmed’s portfolio: projects exploring AI-assisted learning, automated LLM workflows, and Python systems.' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#111514"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head><body><slot/></body></html>
